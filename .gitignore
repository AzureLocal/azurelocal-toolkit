# Terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.backup
# Variable files that config/variables/scripts/New-IacVariableFiles.ps1 writes: they hold IDs and names
terraform.tfvars.json
not-written.txt
src/ansible/inventory/host_vars/
*.tfvars
backend.hcl
!*.tfvars.example
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ansible
ansible/roles/
*.retry
ansible/.vault_pass

# PowerShell
*.psm1~
*.psd1~

# Secrets / credentials
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
*.creds
*.secrets
.env
.env.*
!.env.example

# Central config (actual values — never commit)
config/infrastructure-*.yml
!config/infrastructure.yml
config/variables.yml
config/credentials/

# Log files (keep the directory via .gitkeep)
logs/**
!logs/.gitkeep

# Temp / scratch
temp/

# Editor / OS artifacts
.vscode/
.idea/
*.suo
*.user
Thumbs.db
.DS_Store
*~

# Build output
dist/
out/
build/
site/

node_modules/


# Claude Code local settings (logs and machine-local overrides only)
.claude/logs/
.claude/settings.local.json

# Discovery output: serial numbers and MACs, never committed
/discovery/
infrastructure.discovered.yml
infrastructure*.yml.bak.*

# Python cache
__pycache__/
