!! ===========================================================================
!! Dell OS10 top-of-rack switch configuration for Azure Local: the TEMPLATE.
!! ===========================================================================
!! Rendered once per network_devices[] entry of type switch and vendor Dell by
!! scripts/deploy/03-onprem-readiness/phase-03-network-infrastructure/task-02-dell-powerswitch-configuration/powershell/New-SwitchConfiguration.ps1
!! from infrastructure.yml. Lines that start with !! are notes of the template and are not written; lines that start with ! are
!! OS10 comments and are written. Nothing in this file is a site value: every value of a site is a placeholder named after the
!! infrastructure.yml key it comes from (config/variables/schema/master-registry.yaml). The values that remain are fixed by Dell
!! (OS10 syntax, hardening, the reference port settings) or by Microsoft (Network ATC), each with its source.
!!
!! Placeholders
!!   {{a.b.c}}                 the value of the key. network_devices[] is the switch being rendered.
!!   {{list[].key}}            every value of a list; a line whose list resolves to nothing is left out.
!!   {{a + b + c | filter}}    the values of several keys, through a filter:
!!                               vlan_list     unique VLAN IDs without 0, sorted, comma separated
!!                               vlan_set      the same, as a list for {{#each}}
!!                               trunk_vlans   vlan_list without network_devices[].ports.native_vlan_id (a VLAN is either the
!!                                             untagged VLAN of a port or one of its tagged VLANs, not both)
!!                               prefix_length the prefix length of a CIDR subnet
!!                               os10_timezone the Windows time zone ID as OS10's name, hours and minutes of its UTC offset
!!                               colon_mac     a MAC address as aa:bb:cc:dd:ee:ff
!!   networking.intents[traffic=storage]       the intent whose traffic includes storage; its overrides.qos keys fall back to the
!!                                             registry default (Network ATC: cluster 7, SMB 3, SMB bandwidth 50 percent)
!!   {{atc.cluster_bandwidth_percent}}         Network ATC's cluster heartbeat reservation: 1 percent when the storage intent's
!!                                             adapters are faster than 10 Gbps, else 2 (hardware.network_cards[].ports[].speed_gbps)
!!   {{atc.default_priorities}} and {{atc.default_bandwidth_percent}}  the priorities and the bandwidth left for the default class
!!   {{#each x}} ... {{/each}}  the lines once per element; {{.}} is the element, {{.key}} a key of it
!!   {{#if x}} ... {{/if}}      the lines only when x has a value; {{#if x=v}} only when it equals v
!!
!! Learn: Network ATC default values (https://learn.microsoft.com/windows-server/networking/network-atc/network-atc#default-network-atc-values):
!! cluster heartbeat priority 7 with 1 percent (adapters above 10 Gbps) or 2 percent, SMB Direct priority 3 with 50 percent, the
!! rest priority 0; "This configuration should also be configured on the physical network". Physical network requirements for
!! Azure Local (https://learn.microsoft.com/azure/azure-local/concepts/physical-network-requirements): PFC and ETS on the
!! switch for RDMA storage, jumbo frames.
!! Parked (owner): syslog and SNMP forwarding are not part of the template and have no keys; add them on the switch by hand.
!! ===========================================================================
! ===========================================================================
! Dell OS10 configuration for {{network_devices[].hostname}} (Azure Local top of rack)
! Generated by New-SwitchConfiguration.ps1 from infrastructure.yml. Edit the file, not this output.
! ===========================================================================

configure terminal
hostname {{network_devices[].hostname}}
clock timezone {{site.time_zone | os10_timezone}}

! --- SSH hardening (vendor-fixed: Dell OS10 security guide, the ciphers and MAC the toolkit allows) ---
ip ssh server cipher aes256-ctr aes192-ctr aes128-ctr
ip ssh server mac hmac-sha2-256
ip ssh server enable

! --- LLDP and DCBX (vendor-fixed: Dell's Azure Local reference; DCBX carries PFC and ETS to the hosts) ---
lldp enable
dcbx enable

! --- Console and session (vendor-fixed hardening: no console logging, 30-minute idle timeout) ---
logging console disable
exec-timeout 1800

! ===========================================================================
! Management interface (out-of-band network)
! ===========================================================================
interface mgmt1/1/1
    no shutdown
    no ip address dhcp
    ip address {{network_devices[].management.ip_address}}/{{networking.oob.subnet | prefix_length}}
    no ipv6 enable
    exit

management route 0.0.0.0/0 {{networking.oob.gateway}}

! ===========================================================================
! VLANs: management, the untagged VLAN of the node ports, out-of-band, the workload networks
! ===========================================================================
{{#each networking.management.vlan_id + network_devices[].ports.native_vlan_id + networking.oob.vlan_id + networking.logical_networks[].vlan_id | vlan_set}}
interface vlan {{.}}
    no shutdown
    exit
{{/each}}
{{#if scenario.storage_connectivity=switched}}

! --- Storage VLANs (layer 2 only, RDMA) ---
{{#each networking.storage.networks[]}}
interface vlan {{.vlan_id}}
    description "{{.name}}"
    no shutdown
    exit
{{/each}}
{{/if}}
{{#if scenario.storage_connectivity=switched}}
{{#if networking.intents[traffic=storage]}}

! ===========================================================================
! QoS / DCB: PFC and ETS for RDMA storage, the priorities and reservations of Network ATC
! ===========================================================================
class-map type queuing QDefault
    match queue 0
class-map type queuing QSmb
    match queue {{networking.intents[traffic=storage].overrides.qos.smb_priority}}
class-map type queuing QCluster
    match queue {{networking.intents[traffic=storage].overrides.qos.cluster_priority}}
class-map type network-qos SmbStorage
    match qos-group {{networking.intents[traffic=storage].overrides.qos.smb_priority}}
class-map type network-qos ClusterHeartbeat
    match qos-group {{networking.intents[traffic=storage].overrides.qos.cluster_priority}}

trust dot1p-map trust_map
    qos-group 0 dot1p {{atc.default_priorities}}
    qos-group {{networking.intents[traffic=storage].overrides.qos.smb_priority}} dot1p {{networking.intents[traffic=storage].overrides.qos.smb_priority}}
    qos-group {{networking.intents[traffic=storage].overrides.qos.cluster_priority}} dot1p {{networking.intents[traffic=storage].overrides.qos.cluster_priority}}

qos-map traffic-class queue-map
    queue 0 qos-group {{atc.default_priorities}}
    queue {{networking.intents[traffic=storage].overrides.qos.smb_priority}} qos-group {{networking.intents[traffic=storage].overrides.qos.smb_priority}}
    queue {{networking.intents[traffic=storage].overrides.qos.cluster_priority}} qos-group {{networking.intents[traffic=storage].overrides.qos.cluster_priority}}

policy-map type queuing ets-policy
    class QDefault
        bandwidth percent {{atc.default_bandwidth_percent}}
    class QSmb
        bandwidth percent {{networking.intents[traffic=storage].overrides.qos.smb_bandwidth_percent}}
    class QCluster
        bandwidth percent {{atc.cluster_bandwidth_percent}}

policy-map type network-qos pfc-policy
    class SmbStorage
        pause
        pfc-cos {{networking.intents[traffic=storage].overrides.qos.smb_priority}}

system qos
    trust-map dot1p trust_map
{{/if}}
{{/if}}
{{#if network_devices[].ha.domain_id}}

! ===========================================================================
! Link to the other switch of the pair (VLTi)
! ===========================================================================
{{#each network_devices[].ports.peer_link}}
interface {{.}}
    description VLTi
    no shutdown
    no switchport
    mtu {{network_devices[].mtu}}
    flowcontrol receive off
    flowcontrol transmit off
{{#if scenario.storage_connectivity=switched}}
{{#if networking.intents[traffic=storage]}}
    priority-flow-control mode on
    service-policy input type network-qos pfc-policy
    service-policy output type queuing ets-policy
    ets mode on
    qos-map traffic-class queue-map
{{/if}}
{{/if}}
    exit
{{/each}}
{{/if}}

! ===========================================================================
! Uplinks (trunks to the network above the rack)
! ===========================================================================
{{#each network_devices[].ports.uplinks}}
interface {{.}}
    description Uplink
    no shutdown
    switchport mode trunk
    switchport trunk allowed vlan {{networking.management.vlan_id + network_devices[].ports.native_vlan_id + networking.oob.vlan_id + networking.logical_networks[].vlan_id | vlan_list}}
    mtu {{network_devices[].mtu}}
    flowcontrol receive on
    flowcontrol transmit off
    exit
{{/each}}

! ===========================================================================
! Node ports (the machines' adapters): trunks, untagged frames in the management VLAN
! ===========================================================================
{{#each network_devices[].ports.node_ports}}
interface {{.}}
    description AzureLocalNode
    no shutdown
    switchport mode trunk
{{#if network_devices[].ports.native_vlan_id}}
    switchport access vlan {{network_devices[].ports.native_vlan_id}}
{{/if}}
    switchport trunk allowed vlan {{networking.management.vlan_id + networking.logical_networks[].vlan_id | trunk_vlans}}
{{#if scenario.storage_connectivity=switched}}
    switchport trunk allowed vlan {{networking.storage.networks[].vlan_id | trunk_vlans}}
{{/if}}
    mtu {{network_devices[].mtu}}
    flowcontrol receive off
    flowcontrol transmit off
{{#if scenario.storage_connectivity=switched}}
{{#if networking.intents[traffic=storage]}}
    priority-flow-control mode on
    service-policy input type network-qos pfc-policy
    service-policy output type queuing ets-policy
    ets mode on
    qos-map traffic-class queue-map
{{/if}}
{{/if}}
    spanning-tree bpduguard enable
    spanning-tree port type edge
    exit
{{/each}}
{{#if network_devices[].ha.domain_id}}

! ===========================================================================
! VLT domain (the pair)
! ===========================================================================
vlt-domain {{network_devices[].ha.domain_id}}
    backup destination {{network_devices[].ha.peer_address}}
{{#each network_devices[].ports.peer_link}}
    discovery-interface {{.}}
{{/each}}
    peer-routing
    primary-priority {{network_devices[].ha.priority}}
    vlt-mac {{network_devices[].ha.system_mac | colon_mac}}
    exit
{{/if}}

! ===========================================================================
! Spanning tree (vendor-fixed: RSTP with bridge priority 4096 on both switches, Dell's Azure Local reference)
! ===========================================================================
spanning-tree mode rstp
spanning-tree vlan {{networking.management.vlan_id + network_devices[].ports.native_vlan_id + networking.oob.vlan_id + networking.logical_networks[].vlan_id + networking.storage.networks[].vlan_id | vlan_list}} priority 4096

! ===========================================================================
! DNS and NTP
! ===========================================================================
{{#each networking.management.dns_servers}}
ip name-server {{.}}
{{/each}}
{{#each networking.ntp_servers}}
ntp server {{.}}
{{/each}}

! ===========================================================================
! Logging (local audit log only; syslog and SNMP forwarding are parked by the owner and not configured here)
! ===========================================================================
logging audit enable

! ===========================================================================
! Login. The account is network_devices[].credentials.username; its password is the secret
! named by network_devices[].credentials.password. The generator never reads or writes a password: create the
! account on the switch with the password from the secret store (username <name> password <password> role sysadmin).
! ===========================================================================
! username {{network_devices[].credentials.username}} role sysadmin

! ===========================================================================
! SSH only from the out-of-band network
! ===========================================================================
no ip access-list SSH-Allowed
ip access-list SSH-Allowed
    seq 10 permit ip {{networking.oob.subnet}} any log
    exit

line vty
    ip access-class SSH-Allowed
    exit

end
write memory
