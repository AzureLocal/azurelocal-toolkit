{
  "$comment": "Remote management security profiles for the OS configuration run. One row per environment class (scenario.environment_class in infrastructure.yml). Read by Resolve-AzlRemotingProfile (scripts/common/remoting/AzlRemotingProfile.psm1); edit the values here, not in code. The 'baseline' block is the denylist: it holds in every class, no override can change it, and the resolver refuses a file that weakens it. No network, subscription, host or lab name belongs in this file.",
  "version": "1.0.0",
  "defaultClass": "production",
  "baseline": {
    "allowUnencrypted": false,
    "basicAuth": false,
    "credSsp": false,
    "cbtHardeningLevel": "Strict",
    "httpSysCompatListener": false,
    "skipCACheck": false,
    "skipCNCheck": false,
    "minimumTls": "1.2",
    "rdpNla": true,
    "icmpEchoOnly": true,
    "firewallProfiles": ["Domain", "Private", "Public"],
    "explicitRemoteAddress": true
  },
  "deniedOverrideKeys": ["allow_unencrypted", "basic", "basic_auth", "credssp", "skip_ca_check", "skip_cn_check", "cbt_hardening_level", "http_sys_compat_listener", "minimum_tls", "rdp_nla", "icmp_echo_only"],
  "widestPrefix": {
    "hardFloorV4": 9,
    "hardFloorV6": 9
  },
  "classes": {
    "lab": {
      "relaxed": true,
      "summary": "Isolated lab. Relaxed with the wildcard: TrustedHosts '*' on the machine running the automation, WinRM, RDP and ICMP open to any source on the nodes, HTTP 5985 allowed.",
      "sources": { "any": true, "networkPurposes": ["management", "oob"], "includeAllowedSourceCidrs": true, "includeNodeAddresses": false, "widestPrefixV4": 9, "widestPrefixV6": 9, "requireAtLeastOne": "none", "hostOnly": false },
      "transport": { "defaultScheme": "http", "httpsPolicy": "preferred", "orchestratorMayUseHttp": true, "bootstrapWindowHttp": true },
      "listener": { "bind": "any" },
      "trustedHosts": { "mode": "wildcard", "restoreAfterRun": true },
      "certificate": { "allowSelfSigned": true, "selfSignedOnlyBeforeJoin": false },
      "authentication": { "mode": "negotiate", "description": "Negotiate or NTLM with the local administrator account." },
      "rdp": { "enabled": true, "scope": "sameAsWinRm" },
      "icmp": { "enabled": true, "scope": "sameAsWinRm" },
      "bootstrap": { "allowed": true, "logged": false, "requiresExplicitChoice": false, "approval": "none" },
      "nodeToNode": "subnet",
      "afterDomainJoin": { "reapplyScopeOnDomainProfile": true, "switchToKerberos": true, "clearTrustedHosts": false, "checkGroupPolicy": false, "removeTemporaryJumpRules": false },
      "serverIdentity": "A lab CA or a trusted end-entity certificate; a per-node self-signed certificate is accepted."
    },
    "test": {
      "relaxed": true,
      "summary": "Test environment. Same relaxed posture as lab: TrustedHosts '*', sources Any, HTTP 5985 allowed.",
      "sources": { "any": true, "networkPurposes": ["management", "oob"], "includeAllowedSourceCidrs": true, "includeNodeAddresses": false, "widestPrefixV4": 9, "widestPrefixV6": 9, "requireAtLeastOne": "none", "hostOnly": false },
      "transport": { "defaultScheme": "http", "httpsPolicy": "preferred", "orchestratorMayUseHttp": true, "bootstrapWindowHttp": true },
      "listener": { "bind": "any" },
      "trustedHosts": { "mode": "wildcard", "restoreAfterRun": true },
      "certificate": { "allowSelfSigned": true, "selfSignedOnlyBeforeJoin": false },
      "authentication": { "mode": "negotiate", "description": "Negotiate or NTLM with the local administrator account." },
      "rdp": { "enabled": true, "scope": "sameAsWinRm" },
      "icmp": { "enabled": true, "scope": "sameAsWinRm" },
      "bootstrap": { "allowed": true, "logged": false, "requiresExplicitChoice": false, "approval": "none" },
      "nodeToNode": "subnet",
      "afterDomainJoin": { "reapplyScopeOnDomainProfile": true, "switchToKerberos": true, "clearTrustedHosts": false, "checkGroupPolicy": false, "removeTemporaryJumpRules": false },
      "serverIdentity": "A lab CA or a trusted end-entity certificate; a per-node self-signed certificate is accepted."
    },
    "dev": {
      "relaxed": false,
      "summary": "Development. Sources only from the management and out-of-band networks and allowed_source_cidrs (nothing wider than /24); HTTPS before any second hop; exact TrustedHosts, restored after the run.",
      "sources": { "any": false, "networkPurposes": ["management", "oob"], "includeAllowedSourceCidrs": true, "includeNodeAddresses": true, "widestPrefixV4": 24, "widestPrefixV6": 64, "requireAtLeastOne": "warning", "hostOnly": false },
      "transport": { "defaultScheme": "https", "httpsPolicy": "warn", "orchestratorMayUseHttp": true, "bootstrapWindowHttp": true },
      "listener": { "bind": "managementIp" },
      "trustedHosts": { "mode": "exact", "restoreAfterRun": true },
      "certificate": { "allowSelfSigned": true, "selfSignedOnlyBeforeJoin": false },
      "authentication": { "mode": "negotiate-then-kerberos", "description": "NTLM until the domain join, then Kerberos by FQDN." },
      "rdp": { "enabled": true, "scope": "managementNetworks" },
      "icmp": { "enabled": true, "scope": "managementNetworks" },
      "bootstrap": { "allowed": true, "logged": true, "requiresExplicitChoice": false, "approval": "none" },
      "nodeToNode": "nodeIps",
      "afterDomainJoin": { "reapplyScopeOnDomainProfile": true, "switchToKerberos": true, "clearTrustedHosts": true, "checkGroupPolicy": true, "removeTemporaryJumpRules": false },
      "serverIdentity": "A private CA; a self-signed certificate only for the bootstrap."
    },
    "production": {
      "relaxed": false,
      "summary": "Production (also the class when none is set). Sources only from the marked management and out-of-band networks and allowed_source_cidrs; HTTPS from the first privileged session; no HTTP afterwards; Kerberos after the join.",
      "sources": { "any": false, "networkPurposes": ["management", "oob"], "includeAllowedSourceCidrs": true, "includeNodeAddresses": true, "widestPrefixV4": 24, "widestPrefixV6": 64, "requireAtLeastOne": "error", "hostOnly": false },
      "transport": { "defaultScheme": "https", "httpsPolicy": "required", "orchestratorMayUseHttp": false, "bootstrapWindowHttp": true },
      "listener": { "bind": "managementIp" },
      "trustedHosts": { "mode": "exactIfHttp", "restoreAfterRun": true },
      "certificate": { "allowSelfSigned": true, "selfSignedOnlyBeforeJoin": true },
      "authentication": { "mode": "kerberos-after-join", "description": "Kerberos by FQDN after the join; NTLM only before it." },
      "rdp": { "enabled": true, "scope": "managementNetworks" },
      "icmp": { "enabled": true, "scope": "managementNetworks" },
      "bootstrap": { "allowed": true, "logged": true, "requiresExplicitChoice": true, "approval": "pipeline" },
      "nodeToNode": "nodeIpsPersistent",
      "afterDomainJoin": { "reapplyScopeOnDomainProfile": true, "switchToKerberos": true, "clearTrustedHosts": true, "checkGroupPolicy": true, "removeTemporaryJumpRules": false },
      "serverIdentity": "The enterprise CA after the join; a self-signed certificate only before the join, with its trust installed through an authenticated channel."
    },
    "dmz": {
      "relaxed": false,
      "summary": "DMZ. Exact controller addresses (/32 or /128) and nothing else; HTTPS only; RDP and ICMP off; no TrustedHosts; an enterprise certificate; bootstrap through the BMC or console, or the Arc bootstrap with a per-run approval.",
      "sources": { "any": false, "networkPurposes": [], "includeAllowedSourceCidrs": true, "includeNodeAddresses": true, "widestPrefixV4": 32, "widestPrefixV6": 128, "requireAtLeastOne": "error", "hostOnly": true },
      "transport": { "defaultScheme": "https", "httpsPolicy": "required", "orchestratorMayUseHttp": false, "bootstrapWindowHttp": false },
      "listener": { "bind": "managementIp" },
      "trustedHosts": { "mode": "none", "restoreAfterRun": true },
      "certificate": { "allowSelfSigned": false, "selfSignedOnlyBeforeJoin": false },
      "authentication": { "mode": "kerberos-or-certificate", "description": "Kerberos or a certificate; no NTLM after the build." },
      "rdp": { "enabled": false, "scope": "off" },
      "icmp": { "enabled": false, "scope": "off" },
      "bootstrap": { "allowed": true, "logged": true, "requiresExplicitChoice": true, "approval": "perRun" },
      "nodeToNode": "nodeIpsPersistent",
      "afterDomainJoin": { "reapplyScopeOnDomainProfile": true, "switchToKerberos": true, "clearTrustedHosts": true, "checkGroupPolicy": true, "removeTemporaryJumpRules": true },
      "serverIdentity": "The enterprise CA with a full chain check."
    }
  }
}
