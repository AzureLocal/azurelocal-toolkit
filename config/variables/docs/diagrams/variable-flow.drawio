<mxfile host="drawio"><diagram id="variable-flow" name="Variable flow"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Variable flow: where each value comes from, which file carries it, which tool reads it, and what it becomes" style="text;html=1;whiteSpace=wrap;fontSize=18;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1850" height="36" as="geometry"/></mxCell>
<mxCell id="sub" value="infrastructure.yml is the one master file. Every variable in it is defined once in the master registry (R19); the schema, the master template and the six purpose files are generated from the registry, and the variable map (VARIABLE-MAP.md, variable-map.csv) is generated from the registry plus a scan of the code. Nothing here is edited by hand except the sources on the left." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="0" y="34" width="1850" height="36" as="geometry"/></mxCell>
<mxCell id="c1" value="&lt;b&gt;1. Who provides the value&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="300" height="22" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;2. The master and its generator&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="80" width="380" height="22" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;3. Purpose files (generated subsets)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="80" width="300" height="22" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;4. Tools that read them (phase order)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1170" y="80" width="330" height="22" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;5. What it becomes&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1550" y="80" width="300" height="22" as="geometry"/></mxCell>
<mxCell id="a1" value="&lt;b&gt;Operator, by hand&lt;/b&gt;&lt;br&gt;Designs: scenario, naming, IP plan, identity, hardware, security. Most keys have no other source." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="300" height="84" as="geometry"/></mxCell>
<mxCell id="a2" value="&lt;b&gt;Trailwright questionnaire&lt;/b&gt;&lt;br&gt;The question catalog (path, step, owner, kind) writes the file. About 130 of the keys have a question; optional and conditional ones are flagged." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="214" width="300" height="100" as="geometry"/></mxCell>
<mxCell id="a3" value="&lt;b&gt;Dell/Redfish discovery&lt;/b&gt;&lt;br&gt;Invoke-HardwareDiscovery.ps1 proposes nodes[]: serial_number, ports (name, MAC, slot, port_index, PCI location, vendor, model, speed, rdma). Roles and ip_assignment are placeholders to confirm. Update-InfrastructureYml-FromDiscovery.ps1 applies MACs and serial numbers on request." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="334" width="300" height="130" as="geometry"/></mxCell>
<mxCell id="a4" value="&lt;b&gt;Key Vault references&lt;/b&gt;&lt;br&gt;keyvault://&amp;lt;vault&amp;gt;/&amp;lt;secret&amp;gt; for every password and token. The file never holds a secret value." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="484" width="300" height="84" as="geometry"/></mxCell>
<mxCell id="a5" value="&lt;b&gt;Defaults&lt;/b&gt;&lt;br&gt;The registry default applies when a key is left out (for example security.level, cluster.key_vault.create_new)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="588" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="reg" value="&lt;b&gt;master-registry.yaml&lt;/b&gt; (config/variables/schema)&lt;br&gt;The only master of every variable: type, default, allowed values, used_by (purposes), applies_when, deprecated / replaced_by." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="380" y="110" width="380" height="76" as="geometry"/></mxCell>
<mxCell id="gen" value="&lt;b&gt;New-InfrastructureArtifacts.ps1&lt;/b&gt;&lt;br&gt;Generates infrastructure.schema.json, the master template, the scenario templates and the six purpose schemas and templates. A test regenerates them and fails on any difference." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="380" y="206" width="380" height="84" as="geometry"/></mxCell>
<mxCell id="master" value="&lt;b&gt;infrastructure.yml&lt;/b&gt; (the master file, schema 5.x)&lt;br&gt;One per environment. Sections: scenario, azure, cluster, deployment, nodes, hardware, networking, identity, storage, security, provisioning, os_configuration, devops, and more. Validated against the full schema and the rules of Test-InfrastructureFile.ps1 before any tool uses it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="380" y="320" width="380" height="160" as="geometry"/></mxCell>
<mxCell id="map" value="&lt;b&gt;The variable map&lt;/b&gt; (generated)&lt;br&gt;New-VariableMap.ps1 joins the registry with a scan of the code: toolkit scripts, azurelocal-ztp, azurelocal-sonar, Trailwright. Writes VARIABLE-MAP.md (by phase, by tool, by ARM parameter, where do I set X, unread variables) and variable-map.csv. -Check fails when a committed copy is stale." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="380" y="510" width="380" height="148" as="geometry"/></mxCell>
<mxCell id="p1" value="&lt;b&gt;ztp&lt;/b&gt;&lt;br&gt;Machine provisioning: site, tags, management network, BMC, BIOS, provisioning.simplified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="300" height="84" as="geometry"/></mxCell>
<mxCell id="p2" value="&lt;b&gt;os_configuration&lt;/b&gt;&lt;br&gt;Nodes, ports by MAC, management address, DNS, NTP, local admin, SAN, SBE, domain join, os_configuration.*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="820" y="208" width="300" height="84" as="geometry"/></mxCell>
<mxCell id="p3" value="&lt;b&gt;deployment&lt;/b&gt;&lt;br&gt;ARM Validate/Deploy and the pre-cluster verification: cluster, azure, networking intents, identity, security, storage, deployment.*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="820" y="306" width="300" height="84" as="geometry"/></mxCell>
<mxCell id="p4" value="&lt;b&gt;monitoring&lt;/b&gt;&lt;br&gt;Sonar: azure.*, cluster.name, nodes[].name and management address, evidence_path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="820" y="404" width="300" height="84" as="geometry"/></mxCell>
<mxCell id="p5" value="&lt;b&gt;discovery&lt;/b&gt;&lt;br&gt;Redfish discovery: nodes[].bmc.*, hardware.bmc.*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="820" y="502" width="300" height="84" as="geometry"/></mxCell>
<mxCell id="p6" value="&lt;b&gt;cicd_infra&lt;/b&gt;&lt;br&gt;CI/CD infrastructure: devops.*, azure identity, key_vaults, landing_zone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="820" y="600" width="300" height="84" as="geometry"/></mxCell>
<mxCell id="t1" value="&lt;b&gt;azurelocal-ztp (ZTP)&lt;/b&gt;&lt;br&gt;Installs the OS and registers the Arc machines from the BMC. Reads ConvertFrom-ZtpInfrastructureV5. Writes ztp-handoff.json and ztp-events.jsonl." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1170" y="110" width="330" height="84" as="geometry"/></mxCell>
<mxCell id="t2" value="&lt;b&gt;OS configuration&lt;/b&gt;&lt;br&gt;Set-AzureLocalNodeConfiguration.ps1, Invoke-AzureLocalOsConfiguration.ps1. Steps: RemoteManagement, Drivers, NicNames, Network, Dns, Time, Hostname, UnusedAdapters, DomainJoin, LocalAdmin, Mpio, SanVerify, ClearStorage, Sbe, ArcRegistration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1170" y="208" width="330" height="84" as="geometry"/></mxCell>
<mxCell id="t3" value="&lt;b&gt;Pre-cluster verification + ARM Validate/Deploy&lt;/b&gt;&lt;br&gt;AzlPreClusterVerification.psm1 (check ids ND-, NW-, ST-, ID-, RD-), then New-AzlArmParameterSet builds the template parameters; Invoke-AzureLocalArmDeployment.ps1 submits Validate, then Deploy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1170" y="306" width="330" height="84" as="geometry"/></mxCell>
<mxCell id="t4" value="&lt;b&gt;azurelocal-sonar&lt;/b&gt;&lt;br&gt;Reads the monitoring purpose file and the event feeds; shows the deployment live. Config keys: subscriptionId, resourceGroup, clusterName, nodes[], provisioningRoute, identityModel." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1170" y="404" width="330" height="84" as="geometry"/></mxCell>
<mxCell id="t5" value="&lt;b&gt;Invoke-HardwareDiscovery.ps1&lt;/b&gt;&lt;br&gt;Reads nodes[].bmc.* and hardware.bmc.* and the Key Vault secret for the BMC login; proposes nodes[] back to the file." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1170" y="502" width="330" height="84" as="geometry"/></mxCell>
<mxCell id="t6" value="&lt;b&gt;CI/CD infrastructure&lt;/b&gt;&lt;br&gt;scripts/deploy/01-cicd-infra, AzlCicdInfra.psm1: runners, environments and the Terraform variables from the devops section." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1170" y="600" width="330" height="84" as="geometry"/></mxCell>
<mxCell id="o1" value="&lt;b&gt;ztp-handoff.json (schema 2)&lt;/b&gt;&lt;br&gt;Arc machine resource IDs, installed build, managementAddressVerified. Read by OS configuration and the ARM run." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1550" y="110" width="300" height="84" as="geometry"/></mxCell>
<mxCell id="o2" value="&lt;b&gt;OS configuration report&lt;/b&gt;&lt;br&gt;Ports and OS adapter names by MAC, SAN disks and their IDs. Read by the ARM run: intentList adapter names, infraVolLunId, infraPerfLunId." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1550" y="208" width="300" height="84" as="geometry"/></mxCell>
<mxCell id="o3" value="&lt;b&gt;Verification report&lt;/b&gt;&lt;br&gt;Verdict and per-check results (precluster-verification-events.jsonl). The ARM Deploy needs a current pass." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1550" y="306" width="300" height="84" as="geometry"/></mxCell>
<mxCell id="o4" value="&lt;b&gt;deploymentParameters.json&lt;/b&gt;&lt;br&gt;The parameters of Microsoft&apos;s quickstart template: clusterName, intentList, securityLevel, networkingType, ... Secrets stay keyvault:// references." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1550" y="404" width="300" height="84" as="geometry"/></mxCell>
<mxCell id="az" value="&lt;b&gt;Azure&lt;/b&gt;&lt;br&gt;Arc machines (Microsoft.HybridCompute), Key Vault secrets, Microsoft.AzureStackHCI deployment settings and cluster, Azure Resource Manager Validate and Deploy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1550" y="502" width="300" height="120" as="geometry"/></mxCell>
<mxCell id="ev" value="&lt;b&gt;Event feeds&lt;/b&gt;&lt;br&gt;ztp-events.jsonl, os-configuration-events.jsonl, arm-deployment-events.jsonl: read by Sonar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1550" y="636" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="1" source="a1" target="master"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.5;entryX=0;entryY=0.4;" edge="1" parent="1" source="a2" target="master"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="proposes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.5;entryX=0;entryY=0.6;" edge="1" parent="1" source="a3" target="master"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="references" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="a4" target="master"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="generates from" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="reg" target="gen"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" value="cuts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.3;entryX=0;entryY=0.2;" edge="1" parent="1" source="gen" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" value="cut for a purpose" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="master" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1" target="t1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3" target="t3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p4" target="t4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p5" target="t5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6" target="t6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="g1" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t1" target="o1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="g2" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t2" target="o2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="g3" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t3" target="o3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="g4" value="builds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="t3" target="o4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="g5" value="Validate / Deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="o4" target="az"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="g6" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="t4" target="ev"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
