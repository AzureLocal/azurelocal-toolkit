#Requires -Version 7.0
<#
.SYNOPSIS
    The one place that says what a placeholder script does: it fails, and it changes nothing.

.DESCRIPTION
    Many task folders under scripts/deploy/<stage>/<phase>/<task>/ hold a placeholder: a short script that only imports this
    module and calls Invoke-DeploymentOrchestrated, Invoke-DeploymentStandalone (a PowerShell placeholder) or
    Invoke-DeploymentAzCliPowerShell (an Azure CLI placeholder). A placeholder does not do the task.

    Running a placeholder writes a NOT IMPLEMENTED message to the error stream and ends the script with exit code 3. It
    reads no configuration, copies no file (it no longer creates variables.yml from the example), writes no log file, signs
    in to nothing and calls no command of the task. Nothing is changed, and a user or a pipeline can tell that the step did
    not run.

    Which task folders have a real script, a placeholder or none is in docs/script-status.md (generated by
    New-DeployScriptStatus.ps1). scripts/deploy/common/TaskCatalogue.psd1 says where an Azure CLI script applies.

.NOTES
    Exit codes of a placeholder:

        3   NOT IMPLEMENTED. The script is a placeholder; nothing was changed.

    Why 3: the other entry points of this toolkit already use 0 (done), 1 (failed or not converged) and 2 (bad input or
    nothing reachable; nothing changed) for the OS configuration, the ARM deployment and the pre-cluster verification, and no
    script uses 3. A pipeline that treats every non-zero code as a failure stops on it; one that reads the codes can tell a
    placeholder (3) from a failed run (1) and from bad input (2).

    Parameters that the placeholder scripts pass (-ScriptPath, -InfrastructureFile, -ConfigPath, -Credential, -TargetNode,
    -Configuration, -Parameters, -LogPath) are accepted so the scripts bind, and are not used. A placeholder takes
    -InfrastructureFile, like every script of the toolkit; -ConfigPath is kept here only so that a placeholder that has not been
    changed yet still binds, and goes when the last one passes -InfrastructureFile.
#>

Set-StrictMode -Version Latest

$script:PlaceholderExitCode = 3

function Get-DeploymentPlaceholderExitCode {
    <#
    .SYNOPSIS
        The exit code a placeholder script ends with (3).
    #>
    [CmdletBinding()]
    [OutputType([int])]
    param()

    return $script:PlaceholderExitCode
}

function Get-DeploymentPlaceholderMessage {
    <#
    .SYNOPSIS
        The NOT IMPLEMENTED message of a placeholder.

    .PARAMETER TaskPath
        The task folder, relative to scripts/deploy, for example 03-onprem-readiness/phase-01-active-directory/task-02-security-groups.

    .PARAMETER Kind
        PowerShell or Azure CLI: the kind of script that does not exist yet.

    .PARAMETER ActionName
        The name of the placeholder script, without the extension.
    #>
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(Mandatory)]
        [string]$TaskPath,

        [Parameter(Mandatory)]
        [ValidateSet('PowerShell', 'Azure CLI')]
        [string]$Kind,

        [string]$ActionName = ''
    )

    $name = if ([string]::IsNullOrWhiteSpace($ActionName)) { '' } else { " ('$ActionName' is a placeholder)" }
    $next = if ($Kind -eq 'Azure CLI') {
        'Use the PowerShell script for this task if one exists, or follow the steps on the guide page.'
    }
    else {
        'Look in the powershell folder of this task for a script that does the work, or follow the steps on the guide page.'
    }

    return "NOT IMPLEMENTED: $TaskPath has no $Kind script yet$name. Nothing was changed. $next"
}

function Stop-DeploymentPlaceholder {
    <#
    .SYNOPSIS
        Writes the NOT IMPLEMENTED message to the error stream and ends the running script with exit code 3.

    .DESCRIPTION
        Uses exit, so the script that called the placeholder function ends here: a process started with pwsh -File returns 3,
        and a script run from a session sets $LASTEXITCODE to 3. Nothing is read, copied, written or signed in before this.

    .PARAMETER TaskPath
        The task folder, relative to scripts/deploy.

    .PARAMETER Kind
        PowerShell or Azure CLI.

    .PARAMETER ActionName
        The name of the placeholder script, without the extension.
    #>
    [CmdletBinding()]
    [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSUseShouldProcessForStateChangingFunctions', '', Justification = 'It only ends the running script; it changes nothing.')]
    param(
        [Parameter(Mandatory)]
        [string]$TaskPath,

        [Parameter(Mandatory)]
        [ValidateSet('PowerShell', 'Azure CLI')]
        [string]$Kind,

        [string]$ActionName = ''
    )

    $message = Get-DeploymentPlaceholderMessage -TaskPath $TaskPath -Kind $Kind -ActionName $ActionName
    $Host.UI.WriteErrorLine($message)
    exit $script:PlaceholderExitCode
}

function Invoke-DeploymentStandalone {
    <#
    .SYNOPSIS
        Entry of a standalone PowerShell placeholder. Fails with exit code 3; changes nothing.
    #>
    [CmdletBinding()]
    [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSReviewUnusedParameter', '', Justification = 'The placeholder scripts pass these so that they bind; a placeholder uses none of them.')]
    param(
        [string]$ScriptPath = '',

        [Parameter(Mandatory)]
        [string]$TaskPath,

        [string]$ActionName = '',

        [System.Collections.IDictionary]$Configuration = @{},

        [System.Collections.IDictionary]$Parameters = @{},

        [string]$LogPath = ''
    )

    Stop-DeploymentPlaceholder -TaskPath $TaskPath -Kind 'PowerShell' -ActionName $ActionName
}

function Invoke-DeploymentOrchestrated {
    <#
    .SYNOPSIS
        Entry of an orchestrated PowerShell placeholder. Fails with exit code 3; changes nothing.
    #>
    [CmdletBinding()]
    [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSReviewUnusedParameter', '', Justification = 'The placeholder scripts pass these so that they bind; a placeholder uses none of them.')]
    param(
        [string]$ScriptPath = '',

        [Parameter(Mandatory)]
        [string]$TaskPath,

        [string]$ActionName = '',

        [string]$InfrastructureFile = '',

        [string]$ConfigPath = '',

        [System.Management.Automation.PSCredential]$Credential,

        [string[]]$TargetNode = @(),

        [System.Collections.IDictionary]$Parameters = @{},

        [string]$LogPath = ''
    )

    Stop-DeploymentPlaceholder -TaskPath $TaskPath -Kind 'PowerShell' -ActionName $ActionName
}

function Invoke-DeploymentAzCliPowerShell {
    <#
    .SYNOPSIS
        Entry of an Azure CLI placeholder. Fails with exit code 3; changes nothing.
    #>
    [CmdletBinding()]
    [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSReviewUnusedParameter', '', Justification = 'The placeholder scripts pass these so that they bind; a placeholder uses none of them.')]
    param(
        [string]$ScriptPath = '',

        [Parameter(Mandatory)]
        [string]$TaskPath,

        [string]$ActionName = '',

        [string]$InfrastructureFile = '',

        [string]$ConfigPath = '',

        [System.Collections.IDictionary]$Parameters = @{},

        [string]$LogPath = ''
    )

    Stop-DeploymentPlaceholder -TaskPath $TaskPath -Kind 'Azure CLI' -ActionName $ActionName
}

Export-ModuleMember -Function Get-DeploymentPlaceholderExitCode, Get-DeploymentPlaceholderMessage, Stop-DeploymentPlaceholder, Invoke-DeploymentStandalone, Invoke-DeploymentOrchestrated, Invoke-DeploymentAzCliPowerShell
