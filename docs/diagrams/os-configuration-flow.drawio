<mxfile host="drawio"><diagram id="os-configuration-flow" name="OS configuration flow"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="2121" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Azure Local OS configuration (Phase 03): from the ZTP handoff to ARM Validate and Deploy" style="text;html=1;whiteSpace=wrap;fontSize=18;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="36" as="geometry"/></mxCell>
<mxCell id="sub" value="Set-AzureLocalNodeConfiguration.ps1. Default is a plan that changes nothing; -Execute applies. Steps are listed in the order the script runs them." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="0" y="34" width="1200" height="22" as="geometry"/></mxCell>
<mxCell id="in1" value="&lt;b&gt;ZTP handoff (ztp-handoff.json, schema 2)&lt;/b&gt;&lt;br&gt;What Azure generated: each machine&apos;s Arc machine name and resource ID, the OS build installed, managementAddressVerified. Optional: without it the Arc machines are found by name in azure.resource_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="in2" value="&lt;b&gt;infrastructure.yml (master file, schema 5.4.2)&lt;/b&gt;&lt;br&gt;Nodes and ports by MAC, management address and mode, DNS, NTP, identity.local_admin, SAN, hardware.sbe (bundle_path, delivery, node_pull_url)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="380" y="70" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="read" value="&lt;b&gt;Read and validate (operator host, nothing touched yet)&lt;/b&gt;&lt;br&gt;Schema and rules (AZL-001 to AZL-030, including the SBE delivery rule), Read-AzlHandoff, one node spec per node. The SBE folder in hardware.sbe.bundle_path is hashed against the OEM manifest (SHA-256) before any node is touched. Transport: Azure Arc Run Command (default, through Azure; no path to the nodes needed) or WinRM (-Transport WinRM -Credential)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="205" width="700" height="110" as="geometry"/></mxCell>
<mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="in1" target="read"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="in2" target="read"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="modes" value="Management address mode (per node; the management port is found by its MAC, never by name)" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontStyle=1;fillColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="333" width="600" height="24" as="geometry"/></mxCell>
<mxCell id="mA" value="&lt;b&gt;Mode A: DHCP with reservation&lt;/b&gt;&lt;br&gt;ip_assignment dhcp_reservation. The port keeps DHCP. Only verified: is the reserved address there? Never changed. Info if not (check the reservation for the MAC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="365" width="225" height="150" as="geometry"/></mxCell>
<mxCell id="mB" value="&lt;b&gt;Mode B: static with DHCP on management&lt;/b&gt;&lt;br&gt;ip_assignment static; the management port also has role provisioning, so DHCP carried the install. The static address is set by MAC, DHCP off on the port, gateway added" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="257" y="365" width="225" height="150" as="geometry"/></mxCell>
<mxCell id="mC" value="&lt;b&gt;Mode C: static without management DHCP&lt;/b&gt;&lt;br&gt;ip_assignment static; another port (role provisioning) reached Azure. The static address is set by MAC and DHCP is turned off on the other ports, so only the management port keeps a default gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="494" y="365" width="226" height="150" as="geometry"/></mxCell>
<mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.15;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="read" target="mA"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="read" target="mB"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.85;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="read" target="mC"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="pass" value="&lt;b&gt;For each node: Read, compare, then change only what differs&lt;/b&gt;&lt;br&gt;One read-only script per node (Arc Run Command creates and deletes a transient run command). Every item is compared with the spec and marked Ok, Change, Blocked, Info or Skipped. &lt;b&gt;Plan mode stops here&lt;/b&gt; and prints the table. With &lt;b&gt;-Execute&lt;/b&gt; only the Change items are applied, in the order below, in one Apply call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="550" width="700" height="100" as="geometry"/></mxCell>
<mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.5;exitY=1;entryX=0.17;entryY=0;" edge="1" parent="1" source="mA" target="pass"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mB" target="pass"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.5;exitY=1;entryX=0.83;entryY=0;" edge="1" parent="1" source="mC" target="pass"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s1" value="&lt;b&gt;1. RemoteManagement&lt;/b&gt;&lt;br&gt;WinRM running and automatic with a listener, RDP allowed, ICMP echo on." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;spacingRight=130;" vertex="1" parent="1"><mxGeometry x="20" y="685" width="700" height="44" as="geometry"/></mxCell>
<mxCell id="ts1" value="skip if correct" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="691" width="124" height="20" as="geometry"/></mxCell>
<mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="pass" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s2" value="&lt;b&gt;2. Drivers&lt;/b&gt;&lt;br&gt;OEM network drivers from the SBE package, only for ports whose driver is older than the package&apos;s. Needs the package on the node; if it is not there yet, Skipped and done in the pass after the package lands." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;spacingRight=130;" vertex="1" parent="1"><mxGeometry x="20" y="743" width="700" height="58" as="geometry"/></mxCell>
<mxCell id="ts2" value="skip if same or newer" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="749" width="124" height="20" as="geometry"/></mxCell>
<mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s3" value="&lt;b&gt;3. Network&lt;/b&gt;&lt;br&gt;Management port first (Mode A verified; B and C: static address by MAC, DHCP off, gateway). Then every port with ip_assignment none: DHCP off, no address, no gateway. A second default gateway is Blocked." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;spacingRight=130;" vertex="1" parent="1"><mxGeometry x="20" y="815" width="700" height="58" as="geometry"/></mxCell>
<mxCell id="ts3" value="skip if correct" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="821" width="124" height="20" as="geometry"/></mxCell>
<mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s4" value="&lt;b&gt;4. Dns&lt;/b&gt;&lt;br&gt;DNS servers on the management port (static modes)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;spacingRight=130;" vertex="1" parent="1"><mxGeometry x="20" y="887" width="700" height="44" as="geometry"/></mxCell>
<mxCell id="ts4" value="skip if correct" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="893" width="124" height="20" as="geometry"/></mxCell>
<mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s5" value="&lt;b&gt;5. Time&lt;/b&gt;&lt;br&gt;NTP peers from networking.ntp_servers; reports a free-running source." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;spacingRight=130;" vertex="1" parent="1"><mxGeometry x="20" y="945" width="700" height="44" as="geometry"/></mxCell>
<mxCell id="ts5" value="skip if correct" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="951" width="124" height="20" as="geometry"/></mxCell>
<mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s6" value="&lt;b&gt;6. Hostname&lt;/b&gt;&lt;br&gt;Computer name equals the node name. A rename needs a restart." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;spacingRight=130;" vertex="1" parent="1"><mxGeometry x="20" y="1003" width="700" height="44" as="geometry"/></mxCell>
<mxCell id="ts6" value="skip if correct" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="1009" width="124" height="20" as="geometry"/></mxCell>
<mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s7" value="&lt;b&gt;7. UnusedAdapters&lt;/b&gt;&lt;br&gt;Ports whose only role is unused are disabled." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;spacingRight=130;" vertex="1" parent="1"><mxGeometry x="20" y="1061" width="700" height="44" as="geometry"/></mxCell>
<mxCell id="ts7" value="skip if correct" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="1067" width="124" height="20" as="geometry"/></mxCell>
<mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s8" value="&lt;b&gt;8. LocalAdmin&lt;/b&gt;&lt;br&gt;identity.local_admin exists, enabled, in Administrators, password from Key Vault. Never the built-in Administrator." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;spacingRight=130;" vertex="1" parent="1"><mxGeometry x="20" y="1119" width="700" height="44" as="geometry"/></mxCell>
<mxCell id="ts8" value="skip if correct" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="1125" width="124" height="20" as="geometry"/></mxCell>
<mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s9" value="&lt;b&gt;9. Mpio&lt;/b&gt;&lt;br&gt;SAN only: MultipathIO, the array&apos;s MSDSM hardware ID, load balance policy, MPIO settings (restart if changed)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;spacingRight=130;" vertex="1" parent="1"><mxGeometry x="20" y="1177" width="700" height="44" as="geometry"/></mxCell>
<mxCell id="ts9" value="skip if correct" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="1183" width="124" height="20" as="geometry"/></mxCell>
<mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s10" value="&lt;b&gt;10. SanVerify&lt;/b&gt;&lt;br&gt;SAN only. FC ports and WWPNs; infrastructure and performance history LUNs visible, RAW, big enough, 2+ paths." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;spacingRight=6;spacingRight=130;" vertex="1" parent="1"><mxGeometry x="20" y="1235" width="700" height="44" as="geometry"/></mxCell>
<mxCell id="ts10" value="read only" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="1241" width="124" height="20" as="geometry"/></mxCell>
<mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s9" target="s10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s11" value="&lt;b&gt;11. ClearStorage&lt;/b&gt;&lt;br&gt;Leftover pools, virtual disks and local disks. Wiped only with -ClearStorage -Execute; SAN LUNs are never touched." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;spacingRight=6;spacingRight=130;" vertex="1" parent="1"><mxGeometry x="20" y="1293" width="700" height="44" as="geometry"/></mxCell>
<mxCell id="ts11" value="opt in, destroys data" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="1299" width="124" height="20" as="geometry"/></mxCell>
<mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s10" target="s11"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="restart" value="&lt;b&gt;Restart once if an action asked&lt;/b&gt; (hostname, MPIO, a driver) unless -NoRestart; wait for a new boot time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="1351" width="700" height="40" as="geometry"/></mxCell>
<mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s11" target="restart"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="sbe" value="&lt;b&gt;12. Sbe, LAST: deliver the SBE package to C:\SBE (hardware.sbe.delivery)&lt;/b&gt;&lt;br&gt;Skip if the three files are already on the node with the right SHA-256. Last on purpose: it is the step most likely to fail (it needs a route to the node the other steps do not), and it never stops the others. Arc Run Command cannot carry a file, and there is no storage account route." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;spacingRight=6;spacingRight=130;" vertex="1" parent="1"><mxGeometry x="20" y="1405" width="700" height="84" as="geometry"/></mxCell>
<mxCell id="tsbe" value="skip if hash matches" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="1411" width="124" height="20" as="geometry"/></mxCell>
<mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="restart" target="sbe"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="rSkip" value="&lt;b&gt;skip&lt;/b&gt; (default, or no key)&lt;br&gt;Nothing is delivered. The step says &lt;b&gt;NOT DELIVERED&lt;/b&gt; and the OEM drivers are skipped. No other step fails; exit code and convergence are not affected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="1505" width="225" height="150" as="geometry"/></mxCell>
<mxCell id="rCopy" value="&lt;b&gt;winrm_copy&lt;/b&gt;&lt;br&gt;Copy-Item over a WinRM session (TCP 5985) from the host that runs the script, to C:\SBE\&lt;i&gt;file&lt;/i&gt;.part, SHA-256 checked on the node, renamed. Needs -Credential and that host must reach the nodes&apos; subnet (the operator host if it can, or a runner)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="257" y="1505" width="225" height="150" as="geometry"/></mxCell>
<mxCell id="rPull" value="&lt;b&gt;node_pull&lt;/b&gt;&lt;br&gt;The node downloads each file itself, inside the Run Command, from hardware.sbe.node_pull_url (HTTPS or UNC; no credential in the address) you serve read-only from a host the nodes can reach. Free space checked, .part file, SHA-256 checked on the node, renamed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="494" y="1505" width="226" height="150" as="geometry"/></mxCell>
<mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.15;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sbe" target="rSkip"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sbe" target="rCopy"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.85;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sbe" target="rPull"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="again" value="&lt;b&gt;Read again and repeat&lt;/b&gt; up to -MaxPasses (default 3). The drivers install in the pass after the package has landed. A route that is configured and fails is reported once, not retried, and leaves the node not converged; the other steps stay done" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="1695" width="700" height="70" as="geometry"/></mxCell>
<mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.5;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="rSkip" target="again"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="rCopy" target="again"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="rPull" target="again"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="report" value="&lt;b&gt;Report and exit&lt;/b&gt;&lt;br&gt;JSON report (-ReportPath): ports by MAC with their OS names, SAN disks, what changed, sbeDelivery and sbeNotDelivered. Exit 1 (NOT READY) if anything is Blocked, a node did not converge or SAN disks differ between nodes. Re-running a configured node changes nothing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="1799" width="700" height="84" as="geometry"/></mxCell>
<mxCell id="e28" value="converged" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="again" target="report"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="validate" value="&lt;b&gt;ARM Validate (Phase 05): Invoke-AzureLocalClusterDeployment.ps1 -Mode Validate -Execute&lt;/b&gt;&lt;br&gt;-NodeReportPath is the report above (port names by MAC, SAN disks by LUN). About 10 to 30 minutes; every validation step and error is reported" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="1917" width="700" height="70" as="geometry"/></mxCell>
<mxCell id="e29" value="gate: OS configuration ready" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="report" target="validate"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="deploy" value="&lt;b&gt;ARM Deploy (Phase 05): Invoke-AzureLocalClusterDeployment.ps1 -Mode Deploy -Execute&lt;/b&gt;&lt;br&gt;A separate, explicit run. Needs a Validate that succeeded. 2.5 to 3 hours" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="2021" width="700" height="60" as="geometry"/></mxCell>
<mxCell id="e30" value="gate: Validate succeeded" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="validate" target="deploy"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n1" value="Plan first: without -Execute one read-only script per node runs and nothing changes. The table lists every item as Ok, Change, Blocked, Info or Skipped. Re-run with -Execute to apply." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="440" height="70" as="geometry"/></mxCell>
<mxCell id="n2" value="Idempotent means the node is read first and an item that already matches is left alone: a node that matches its spec gets one Read and no Apply. Green tags: skip if already correct. Grey: read only, never changes the node. Red: only on request." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="760" y="205" width="440" height="90" as="geometry"/></mxCell>
<mxCell id="n3" value="Port names are not trusted: the installed OS names ports Port0 to Port6, so every action finds its port by MAC." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="760" y="365" width="440" height="56" as="geometry"/></mxCell>
<mxCell id="n4" value="In Mode C a node reached over Arc through its provisioning port keeps a way out: the management port&apos;s static address is applied first, before any other port loses DHCP and its gateway." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="760" y="440" width="440" height="76" as="geometry"/></mxCell>
<mxCell id="n5" value="Sbe is the only step that needs a route the others do not. skip is honest: it tells you the package is not on the node. Everything the operator host cannot reach over WinRM (192.168.211.0/24 here) is why node_pull exists." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="760" y="1505" width="440" height="90" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>