# =============================================================================
# Ansible Inventory — example (neutral values)
# =============================================================================
# Copy to hosts.yml. The host names of cluster_nodes are the names in nodes[].name of
# infrastructure.yml: the os-configuration role sets each node's host name from the inventory
# name, and config/variables/scripts/New-IacVariableFiles.ps1 writes inventory/host_vars/<name>.yml
# (mgmt_ip, mgmt_nic_name) for each of them. The addresses below are documentation addresses:
# use the ones of nodes[].management.ip_address and of the management VMs.
# The variables of group_vars/all.yml come from the same script.
# =============================================================================
all:
  children:
    # Active Directory domain controllers (management VMs)
    domain_controllers:
      hosts:
        iic-dc01:
          ansible_host: 192.0.2.4
        iic-dc02:
          ansible_host: 192.0.2.5

    # Management servers
    management:
      hosts:
        iic-jumpbox:
          ansible_host: 192.0.2.20
        iic-wac01:
          ansible_host: 192.0.2.21
        iic-syslog01:
          ansible_host: 192.0.2.22

    # Azure Local cluster nodes
    cluster_nodes:
      hosts:
        iic-azl-n01:
          ansible_host: 192.0.2.11
        iic-azl-n02:
          ansible_host: 192.0.2.12

    # Windows hosts (all groups combined)
    windows:
      children:
        domain_controllers:
        management:
        cluster_nodes:
      vars:
        ansible_connection: winrm
        ansible_winrm_transport: kerberos
        ansible_winrm_server_cert_validation: ignore
        ansible_port: 5986
