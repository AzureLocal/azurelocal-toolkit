# Written by config/variables/scripts/New-IacVariableFiles.ps1 from nodes[] and landing_zone.virtual_machines[] of infrastructure.yml. Do not edit.
# ansible_host is the management address of a node and the private_ip of a virtual machine. The vm_role_<role> groups list the virtual machines by role. The connection settings of the windows group are settings of the code (tools.ansible.variables).
all:
  children:
    domain_controllers:
      hosts:
        iic-dc01:
          ansible_host: 10.20.0.134
    cluster_nodes:
      hosts:
        iic-azl-n01:
          ansible_host: 192.0.2.11
        iic-azl-n02:
          ansible_host: 192.0.2.12
    vm_role_domain_controller:
      hosts:
        iic-dc01: {}
    windows:
      children:
        domain_controllers: {}
        cluster_nodes: {}
      vars:
        ansible_connection: winrm
        ansible_winrm_transport: kerberos
        ansible_winrm_server_cert_validation: ignore
        ansible_port: 5986
