# Written by config/variables/scripts/New-IacVariableFiles.ps1 from devops.runners[] of infrastructure.yml. Do not edit.
# One group per runner entry. ansible-playbook -i inventory/cicd-runners.yml playbooks/00-cicd-runner.yml. No secret is in this file.
# ansible_ssh_private_key_file: not written. Pass it at run time: --private-key <file>.
# ansible_password: not written. Pass it with -e @vault.yml (Ansible Vault) at run time.
all:
  children:
    cicd_runners_linux:
      children:
        cicd_runner_vm_iic_runner_lnx:
          hosts:
            vm-iic-runner-lnx-01:
              ansible_host: 10.20.10.4
          vars:
            ansible_user: runneradmin
            ansible_become: true
            cicd_runner_purpose: general
            cicd_runner_extra_labels:
            - azure-local
            cicd_runner_key_vault_name: kv-iic-mgmt-01
            cicd_runner_secret_name: github-runner-token
    cicd_runners_windows:
      children:
        cicd_runner_vm_iic_runner_ztp:
          hosts:
            vm-iic-runner-ztp-01:
              ansible_host: 10.20.10.68
          vars:
            ansible_user: runneradmin
            cicd_runner_purpose: ztp
            cicd_runner_github_runner_group: azurelocal-ztp
            cicd_runner_azure_devops_pool: azurelocal-ztp
            cicd_runner_key_vault_name: kv-iic-mgmt-01
            cicd_runner_secret_name: github-runner-token
            cicd_runner_windows_init_data_disk: true
      vars:
        ansible_connection: winrm
        ansible_winrm_transport: kerberos
        ansible_winrm_server_cert_validation: ignore
        ansible_port: 5986
